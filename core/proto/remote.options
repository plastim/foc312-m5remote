# The remote decodes every text field it needs as a fixed buffer: nanopb cannot arm callbacks inside a oneof, so the
# firmware build's callback fields would be dropped. The wire format is unchanged; only the C structs differ.
focstim_rpc.FirmwareVersion.branch max_size:24
focstim_rpc.FirmwareVersion.comment max_size:64
focstim_rpc.NotificationDebugString.message max_size:200
focstim_rpc.NotificationDebugTeleplot.id max_size:32
focstim_rpc.RequestWifiParametersSet.ssid max_size:32
focstim_rpc.RequestWifiParametersSet.password max_size:64
